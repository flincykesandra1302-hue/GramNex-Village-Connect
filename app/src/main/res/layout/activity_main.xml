<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_splash_gradient">

    <!-- Decorative Golden Circles -->

    <View
        android:layout_width="180dp"
        android:layout_height="180dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="-60dp"
        android:layout_marginEnd="-40dp"
        android:background="@drawable/circle_yellow"
        android:alpha="0.15"/>

    <View
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="80dp"
        android:layout_marginStart="-30dp"
        android:background="@drawable/circle_green"
        android:alpha="0.18"/>

    <!-- Main Content -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="28dp">

        <!-- Glowing Logo -->

        <androidx.cardview.widget.CardView
            android:layout_width="130dp"
            android:layout_height="130dp"
            app:cardBackgroundColor="#26FFFFFF"
            app:cardCornerRadius="65dp"
            app:cardElevation="12dp">

            <ImageView
                android:id="@+id/imgLogo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="18dp"
                android:src="@drawable/village_logo"
                android:scaleType="centerInside"/>

        </androidx.cardview.widget.CardView>

        <!-- App Name -->

        <TextView
            android:id="@+id/txtTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="Village Connect AI"
            android:textColor="@android:color/white"
            android:textSize="30sp"
            android:textStyle="bold"/>

        <!-- Subtitle -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Bridging Rural Citizens with Government Welfare"
            android:textAlignment="center"
            android:textColor="#D8F3DC"
            android:textSize="15sp"/>

        <!-- AI Badge -->

        <LinearLayout
            android:id="@+id/badgeAI"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_ai_badge"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingLeft="16dp"
            android:paddingTop="8dp"
            android:paddingRight="16dp"
            android:paddingBottom="8dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_bolt"
                android:tint="@color/green_dark"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="AI Powered Platform"
                android:textColor="@color/green_dark"
                android:textSize="13sp"
                android:textStyle="bold"/>

        </LinearLayout>

        <!-- Quote -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:text="Empowering every village with smart digital governance."
            android:textAlignment="center"
            android:textColor="#F8F9FA"
            android:textSize="14sp"/>

    </LinearLayout>

    <!-- Bottom Join Button -->

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnJoin"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:layout_alignParentBottom="true"
        android:layout_margin="22dp"
        android:text="Get Started"
        android:textAllCaps="false"
        android:textColor="@color/green_dark"
        android:textSize="17sp"
        app:backgroundTint="@color/yellow_primary"
        app:cornerRadius="20dp"
        app:icon="@drawable/ic_arrow_forward"
        app:iconGravity="textEnd"
        app:iconPadding="8dp"
        app:iconTint="@color/green_dark"/>

</RelativeLayout>